rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verifiedAlu() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('[ -~]+')
        && request.auth.token.email.matches('^[^@ ]+@(alustudent[.]com|alueducation[.]com)$');
    }
    function staff() { return verifiedAlu() && request.auth.token.get('staff', false) == true; }
    function text(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max && value.matches('[ -~\r\n]+');
    }
    function valid(data) {
      return data.keys().hasAll(['ownerId', 'reporterName', 'title', 'description', 'location', 'category', 'status', 'photoPath', 'createdAt', 'updatedAt', 'history'])
        && data.keys().hasOnly(['ownerId', 'reporterName', 'title', 'description', 'location', 'category', 'status', 'photoPath', 'createdAt', 'updatedAt', 'history'])
        && data.ownerId is string && text(data.reporterName, 2, 60)
        && text(data.title, 5, 100) && text(data.description, 20, 2000) && text(data.location, 3, 120)
        && data.category in ['facilities', 'water', 'electricity', 'furniture', 'safety', 'sanitation']
        && data.status in ['submitted', 'inProgress', 'resolved']
        && data.createdAt is timestamp && data.updatedAt == request.time
        && data.photoPath is string && data.history is map;
    }
    function event(value, status) {
      return value is map && value.keys().hasAll(['status', 'at', 'by', 'note'])
        && value.keys().hasOnly(['status', 'at', 'by', 'note'])
        && value.status == status && value.at == request.time
        && value.by == request.auth.uid && text(value.note, 5, 300);
    }
    match /incidents/{id} {
      allow read: if verifiedAlu() && (resource.data.ownerId == request.auth.uid || staff());
      allow create: if verifiedAlu() && valid(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.photoPath == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.history.keys().hasOnly(['submitted'])
        && event(request.resource.data.history.submitted, 'submitted');
      allow update: if verifiedAlu() && valid(request.resource.data) && (
        (resource.data.ownerId == request.auth.uid && resource.data.status == 'submitted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'location', 'category', 'photoPath', 'updatedAt'])
          && (request.resource.data.photoPath == resource.data.photoPath
            || (resource.data.photoPath == '' && request.resource.data.photoPath == 'incidents/' + request.auth.uid + '/' + id + '/photo')))
        || (staff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'history', 'updatedAt'])
          && ((resource.data.status == 'submitted' && request.resource.data.status == 'inProgress')
            || (resource.data.status == 'inProgress' && request.resource.data.status == 'resolved'))
          && request.resource.data.history.diff(resource.data.history).affectedKeys().hasOnly([request.resource.data.status])
          && request.resource.data.history.size() == resource.data.history.size() + 1
          && event(request.resource.data.history[request.resource.data.status], request.resource.data.status))
      );
      allow delete: if verifiedAlu() && resource.data.ownerId == request.auth.uid && resource.data.status == 'submitted';
    }
  }
}
